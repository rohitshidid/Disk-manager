<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Inert until the app is signed with a Developer ID and the hardened runtime is
  switched on (see the `mac.hardenedRuntime` key). Kept in the repo so that the
  day someone adds credentials, the build does not also have to work out which
  exemptions Electron needs.

  disable-library-validation is the one that is specific to this app: it ships
  its own ncdu and two dylibs, signed ad-hoc rather than with the same team ID
  as the bundle, and the hardened runtime refuses to load those without it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.inherit</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
